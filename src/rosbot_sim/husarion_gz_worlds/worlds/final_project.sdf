<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="final_project">
    <physics name="1ms" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact" />
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu" />
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors" />
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>50.088384</latitude_deg>
      <longitude_deg>19.939128</longitude_deg>
      <elevation>0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- ================================================================= -->
    <!-- Ground plane                                                       -->
    <!-- ================================================================= -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
            <specular>0.5 0.5 0.5 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================================================================= -->
    <!-- Disaster zone: walls forming rooms and corridors.                  -->
    <!-- The robot starts at the origin (base station).                    -->
    <!-- Four search zones are placed at accessible locations.             -->
    <!-- Wall height: 1.0 m, thickness: 0.15 m                            -->
    <!-- ================================================================= -->

    <!-- Outer walls (12 m x 10 m perimeter) -->

    <!-- North wall -->
    <model name="wall_north">
      <static>true</static>
      <link name="link">
        <pose>0 5.0 0.5 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>12.0 0.15 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>12.0 0.15 1.0</size></box></geometry>
          <material>
            <ambient>0.6 0.55 0.5 1</ambient>
            <diffuse>0.6 0.55 0.5 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- South wall -->
    <model name="wall_south">
      <static>true</static>
      <link name="link">
        <pose>0 -5.0 0.5 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>12.0 0.15 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>12.0 0.15 1.0</size></box></geometry>
          <material>
            <ambient>0.6 0.55 0.5 1</ambient>
            <diffuse>0.6 0.55 0.5 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- East wall -->
    <model name="wall_east">
      <static>true</static>
      <link name="link">
        <pose>6.0 0 0.5 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.15 10.15 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.15 10.15 1.0</size></box></geometry>
          <material>
            <ambient>0.6 0.55 0.5 1</ambient>
            <diffuse>0.6 0.55 0.5 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- West wall -->
    <model name="wall_west">
      <static>true</static>
      <link name="link">
        <pose>-6.0 0 0.5 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.15 10.15 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.15 10.15 1.0</size></box></geometry>
          <material>
            <ambient>0.6 0.55 0.5 1</ambient>
            <diffuse>0.6 0.55 0.5 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Interior walls creating rooms -->

    <!-- Horizontal divider (left half) - creates NW and SW rooms -->
    <model name="wall_h_left">
      <static>true</static>
      <link name="link">
        <pose>-3.0 0 0.5 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>5.85 0.15 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>5.85 0.15 1.0</size></box></geometry>
          <material>
            <ambient>0.55 0.50 0.45 1</ambient>
            <diffuse>0.55 0.50 0.45 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Horizontal divider (right half) - creates NE and SE rooms -->
    <model name="wall_h_right">
      <static>true</static>
      <link name="link">
        <pose>3.5 0 0.5 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>4.85 0.15 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>4.85 0.15 1.0</size></box></geometry>
          <material>
            <ambient>0.55 0.50 0.45 1</ambient>
            <diffuse>0.55 0.50 0.45 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Vertical divider (top half) - creates NW and NE rooms -->
    <model name="wall_v_top">
      <static>true</static>
      <link name="link">
        <pose>0 3.25 0.5 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.15 3.35 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.15 3.35 1.0</size></box></geometry>
          <material>
            <ambient>0.55 0.50 0.45 1</ambient>
            <diffuse>0.55 0.50 0.45 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Vertical divider (bottom half) - creates SW and SE rooms -->
    <model name="wall_v_bottom">
      <static>true</static>
      <link name="link">
        <pose>0 -3.25 0.5 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.15 3.35 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.15 3.35 1.0</size></box></geometry>
          <material>
            <ambient>0.55 0.50 0.45 1</ambient>
            <diffuse>0.55 0.50 0.45 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Debris / obstacles inside rooms -->

    <model name="debris_1">
      <static>true</static>
      <link name="link">
        <pose>-4.5 3.8 0.25 0 0 0.4</pose>
        <collision name="collision">
          <geometry><box><size>0.8 0.4 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.8 0.4 0.5</size></box></geometry>
          <material>
            <ambient>0.4 0.35 0.3 1</ambient>
            <diffuse>0.4 0.35 0.3 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="debris_2">
      <static>true</static>
      <link name="link">
        <pose>3.0 -3.0 0.2 0 0 -0.3</pose>
        <collision name="collision">
          <geometry><box><size>0.6 0.6 0.4</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.6 0.6 0.4</size></box></geometry>
          <material>
            <ambient>0.4 0.35 0.3 1</ambient>
            <diffuse>0.4 0.35 0.3 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="debris_3">
      <static>true</static>
      <link name="link">
        <pose>4.0 2.5 0.15 0 0 0.8</pose>
        <collision name="collision">
          <geometry><box><size>1.0 0.3 0.3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.0 0.3 0.3</size></box></geometry>
          <material>
            <ambient>0.35 0.30 0.25 1</ambient>
            <diffuse>0.35 0.30 0.25 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="debris_4">
      <static>true</static>
      <link name="link">
        <pose>-2.0 -2.5 0.3 0 0 1.2</pose>
        <collision name="collision">
          <geometry><cylinder><radius>0.3</radius><length>0.6</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.3</radius><length>0.6</length></cylinder></geometry>
          <material>
            <ambient>0.45 0.40 0.35 1</ambient>
            <diffuse>0.45 0.40 0.35 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================================================================= -->
    <!-- Search zone markers (visual only, no collision).                   -->
    <!--                                                                    -->
    <!-- Each zone is a colored disk on the floor with a label.             -->
    <!-- These are visual cues only -- the robot does not perceive them.    -->
    <!--                                                                    -->
    <!--   Zone A: (-3.0,  3.0)  -- NW room (red)    -- has survivor       -->
    <!--   Zone B: ( 3.5,  3.0)  -- NE room (green)  -- no survivor        -->
    <!--   Zone C: ( 4.0, -3.0)  -- SE room (blue)   -- has survivor       -->
    <!--   Zone D: (-3.5, -3.0)  -- SW room (yellow)  -- no survivor       -->
    <!--                                                                    -->
    <!--   Base:   ( 0.0,  0.0)  -- center (white)                         -->
    <!-- ================================================================= -->

    <!-- Zone A marker (NW room, red) -->
    <model name="zone_a_marker">
      <static>true</static>
      <link name="link">
        <pose>-3.0 3.0 0.003 0 0 0</pose>
        <visual name="disk">
          <geometry>
            <cylinder>
              <radius>0.30</radius>
              <length>0.005</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.90 0.15 0.15 1</ambient>
            <diffuse>0.90 0.15 0.15 1</diffuse>
            <specular>0.10 0.10 0.10 1</specular>
          </material>
        </visual>
        <visual name="label">
          <pose>0 0 0.006 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.08</radius>
              <length>0.002</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>1.0 1.0 1.0 1</ambient>
            <diffuse>1.0 1.0 1.0 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Zone B marker (NE room, green) -->
    <model name="zone_b_marker">
      <static>true</static>
      <link name="link">
        <pose>3.5 3.0 0.003 0 0 0</pose>
        <visual name="disk">
          <geometry>
            <cylinder>
              <radius>0.30</radius>
              <length>0.005</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.15 0.80 0.15 1</ambient>
            <diffuse>0.15 0.80 0.15 1</diffuse>
            <specular>0.10 0.10 0.10 1</specular>
          </material>
        </visual>
        <visual name="label">
          <pose>0 0 0.006 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.08</radius>
              <length>0.002</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>1.0 1.0 1.0 1</ambient>
            <diffuse>1.0 1.0 1.0 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Zone C marker (SE room, blue) -->
    <model name="zone_c_marker">
      <static>true</static>
      <link name="link">
        <pose>4.0 -3.0 0.003 0 0 0</pose>
        <visual name="disk">
          <geometry>
            <cylinder>
              <radius>0.30</radius>
              <length>0.005</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.15 0.15 0.90 1</ambient>
            <diffuse>0.15 0.15 0.90 1</diffuse>
            <specular>0.10 0.10 0.10 1</specular>
          </material>
        </visual>
        <visual name="label">
          <pose>0 0 0.006 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.08</radius>
              <length>0.002</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>1.0 1.0 1.0 1</ambient>
            <diffuse>1.0 1.0 1.0 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Zone D marker (SW room, yellow) -->
    <model name="zone_d_marker">
      <static>true</static>
      <link name="link">
        <pose>-3.5 -3.0 0.003 0 0 0</pose>
        <visual name="disk">
          <geometry>
            <cylinder>
              <radius>0.30</radius>
              <length>0.005</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.90 0.85 0.10 1</ambient>
            <diffuse>0.90 0.85 0.10 1</diffuse>
            <specular>0.10 0.10 0.10 1</specular>
          </material>
        </visual>
        <visual name="label">
          <pose>0 0 0.006 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.08</radius>
              <length>0.002</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>1.0 1.0 1.0 1</ambient>
            <diffuse>1.0 1.0 1.0 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Base station marker (center, white) -->
    <model name="base_station_marker">
      <static>true</static>
      <link name="link">
        <pose>0 0 0.003 0 0 0</pose>
        <visual name="disk">
          <geometry>
            <cylinder>
              <radius>0.35</radius>
              <length>0.005</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.95 0.95 0.95 1</ambient>
            <diffuse>0.95 0.95 0.95 1</diffuse>
            <specular>0.10 0.10 0.10 1</specular>
          </material>
        </visual>
        <visual name="cross_h">
          <pose>0 0 0.006 0 0 0</pose>
          <geometry>
            <box><size>0.25 0.05 0.002</size></box>
          </geometry>
          <material>
            <ambient>0.90 0.15 0.15 1</ambient>
            <diffuse>0.90 0.15 0.15 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
        <visual name="cross_v">
          <pose>0 0 0.006 0 0 0</pose>
          <geometry>
            <box><size>0.05 0.25 0.002</size></box>
          </geometry>
          <material>
            <ambient>0.90 0.15 0.15 1</ambient>
            <diffuse>0.90 0.15 0.15 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
